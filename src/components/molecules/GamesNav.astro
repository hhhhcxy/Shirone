---
import Chip from "@components/atoms/action/Chip.astro";
import Card from "@components/atoms/display/Card.svelte";
import K from "@i18n/i18nKey";import {i18n} from "@i18n/translation";import {url} from "@utils/url-utils";
interface Props {kind?:string}
const {kind}=Astro.props;
---
<nav data-games-nav data-section={kind||""} aria-label={i18n(K.games)} class="mb-4"><Card color="var(--card-bg)" radius="l" class="p-2"><div class="flex gap-2 overflow-x-auto hide-scrollbar">{[["",K.gamesOverview],["all",K.gamesAll],["reviews",K.gamesReviews],["categories",K.categories],["grades",K.gamesRating],["tags",K.tags]].map(([path,key])=><Chip href={url('/games/'+(path?path+'/':''))} variant="tonal" class="shrink-0" selected={(path==="categories" && (kind==="product" || kind==="service"))||kind===path||(!kind&&!path)}>{i18n(key as K)}</Chip>)}</div></Card></nav>