---
import {formatInstantDateInSiteTimeZone} from "@utils/content-date";
import PostCard from "@components/atoms/blog/PostCard.astro";
import GameCover from "@components/molecules/GameCover.astro";
import GameGrade from "@components/molecules/GameGrade.astro";
import type {LibraryGame} from "@utils/game-library";
import {url} from "@utils/url-utils";
import K from "@i18n/i18nKey";
import {i18n} from "@i18n/translation";
import { render } from "astro:content";
interface Props { game: LibraryGame; reviewList?: boolean }
const { game, reviewList } = Astro.props;
const d = game.data;
const href = url("/games/"+game.id+"/");
const reviewed = Boolean(game.body?.trim());
const words = reviewed ? (await render(game)).remarkPluginFrontmatter.words : undefined;
const date = reviewed && d.reviewUpdated ? formatInstantDateInSiteTimeZone(d.reviewUpdated) : undefined;
---
<PostCard class="library-card" {href} title={d.title}
  published={date}
  category={{name:i18n(d.kind==="product"?K.gamesProduct:K.gamesService),href:url("/games/"+d.kind+"/")}}
  tags={d.tags.map(name=>({name,href:url("/games/all/")+"?gameTag="+encodeURIComponent(name)}))}
  wordCount={words === undefined ? undefined : words+" "+i18n(words===1?K.wordCount:K.wordsCount)}
  description={reviewList ? d.summary : undefined}>
  <div slot="cover" class="cover"><GameCover src={game.coverUrl}/></div>
  <div slot="details" class="game-facts"><GameGrade grade={d.grade}/>{d.status && <span>{d.status}</span>}
    {d.hours!==undefined && <span>{d.hours} {i18n(K.gamesHours)}</span>}
  </div>
</PostCard>
<style>
.cover{position:absolute;inset:0}.cover :global(.game-cover){height:100%;border-radius:inherit}
.game-facts{display:flex;align-items:center;flex-wrap:wrap;gap:var(--m3e-space-2);margin-top:var(--m3e-space-3);color:var(--on-surface-variant);font:var(--m3e-type-label-medium)}
</style>
