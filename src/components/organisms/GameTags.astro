---
import WidgetLayout from "@components/molecules/WidgetLayout.astro";
import {getGames} from "@utils/game-library";
import {gamesConfig} from "@/config/gamesConfig";
import K from "@i18n/i18nKey";import {i18n} from "@i18n/translation";import {url} from "@utils/url-utils";
const games=gamesConfig.enable?await getGames():[];
const tags=Array.from(new Set(games.flatMap(g=>g.data.tags))).sort().map(tag=>({tag,service:games.filter(g=>g.data.kind==='service'&&g.data.tags.includes(tag)).length,product:games.filter(g=>g.data.kind==='product'&&g.data.tags.includes(tag)).length}));
---
{gamesConfig.enable&&<><WidgetLayout id="game-categories" name={i18n(K.categories)}><div class="flex flex-wrap gap-2">{(["product","service"] as const).map(kind=><a class="tag" data-game-category href={url("/games/"+kind+"/")}>{i18n(kind==="product"?K.gamesProduct:K.gamesService)} <span>{games.filter(g=>g.data.kind===kind).length}</span></a>)}</div></WidgetLayout><WidgetLayout id="game-tags" name={i18n(K.tags)}><div class="flex flex-wrap gap-2"><a class="tag" href={url('/games/all/')} data-game-tag-link="">{i18n(K.tagsViewAll)}</a>{tags.map(({tag,service,product})=><a class="tag" href={url('/games/all/')+'?gameTag='+encodeURIComponent(tag)} data-game-tag-link={tag}  data-service-count={service} data-product-count={product}>{tag}<span>{service+product}</span></a>)}</div></WidgetLayout></>}
<style>.tag{display:inline-flex;align-items:center;gap:var(--m3e-space-2);padding:var(--m3e-space-2) var(--m3e-space-3);border-radius:var(--shape-corner-full);background:var(--surface-container-high);color:var(--on-surface);font:var(--m3e-type-label-large)}.tag[aria-current]{background:var(--primary-container);color:var(--on-primary-container)}.tag:focus-visible{outline:3px solid var(--primary)}.tag[hidden]{display:none}.tag span{color:var(--on-surface-variant)}</style>
<script>import "@utils/game-filter";</script>