---
import TagList from "@components/atoms/blog/TagList.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
/**
 * 标签侧栏组件（消费 blog/TagList 原子）。
 * 只负责取数转 props：标签名 + 标签 URL。
 * 超过侧栏展示上限（collapseAfter）时，只展示前 N 项，并在卡片底部提供
 * 唯一的「查看全部标签」入口，指向标签索引页（/tags/）。
 */
import Icon from "@iconify/svelte";
import { getTagList } from "@utils/content-utils";
import { getTagUrl, url } from "@utils/url-utils";
import type { TagsWidget } from "@/types/sidebarConfig";
import WidgetLayout from "./WidgetLayout.astro";



interface Props {
	items?: {name:string;href:string;count:number}[];
	indexHref?: string;
	id?: string;
	class?: string;
	style?: string;
	widget?: TagsWidget;
}
const className = Astro.props.class;
const style = Astro.props.style;

const DISPLAY_LIMIT = Math.max(1, Astro.props.widget?.collapseAfter ?? 20);
const items = Astro.props.items ?? (await getTagList()).map(t=>({...t,href:getTagUrl(t.name)}));
const hasOverflow = items.length > DISPLAY_LIMIT;
const visibleItems = items.slice(0,DISPLAY_LIMIT);
---
<WidgetLayout name={i18n(I18nKey.tags)} id={Astro.props.id ?? "tags"} class={className} style={style}>
	<TagList tags={visibleItems} />
	{hasOverflow && (
		<div slot="footer" class="widget-index-link">
			<a href={Astro.props.indexHref ?? url("/tags/")} class="m3-state-layer">
				{i18n(I18nKey.tagsViewAll)}
				<Icon icon="material-symbols:chevron-right-rounded" />
			</a>
		</div>
	)}
</WidgetLayout>

<style lang="stylus">
.widget-index-link
	padding: var(--m3e-space-2) var(--m3e-space-4) 0
	> a
		display: flex
		align-items: center
		justify-content: center
		gap: var(--m3e-space-1)
		width: 100%
		min-height: 2.5rem
		padding: 0 var(--m3e-space-2)
		border-radius: var(--shape-corner-m)
		color: var(--primary)
		font: var(--m3e-type-label-large)
		font-weight: 600
		text-decoration: none
		--m3e-state-color: var(--primary)
		transition: background-color var(--m3e-duration-short) var(--m3e-easing-standard)
		> :global(svg)
			width: 1.125rem
			height: 1.125rem
</style>
