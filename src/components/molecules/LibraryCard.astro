---
import GameCover from "@components/molecules/GameCover.astro";
import GameGrade from "@components/molecules/GameGrade.astro";
import type {LibraryGame} from "@utils/game-library";
import {url} from "@utils/url-utils";
import K from "@i18n/i18nKey";
import {i18n} from "@i18n/translation";
import { render } from "astro:content";
interface Props { game: LibraryGame; reviewList?: boolean }
const { game, reviewList } = Astro.props;
const d = game.data;
const href = url("/games/"+game.id+"/");
const reviewed = Boolean(game.body?.trim());
const words = reviewed ? (await render(game)).remarkPluginFrontmatter.words : undefined;
const date = reviewed ? d.reviewUpdated?.toISOString().slice(0,10) : undefined;
---
<article class="library-card">
<a class="cover" href={href} aria-label={d.title}><GameCover src={game.coverUrl}/></a>
<div class="copy">
  <h2><a href={href}>{d.title}</a></h2>
  {reviewed && <p class="review-meta">{i18n(K.gamesReviews)}{date && <> · <time datetime={date}>{date}</time></>}{words !== undefined && <> · {words} {i18n(words===1?K.wordCount:K.wordsCount)}</>}</p>}
  {reviewList && d.summary && <p>{d.summary}</p>}
  <div class="tags"><a href={url("/games/"+d.kind+"/")}>{i18n(d.kind==="product"?K.gamesProduct:K.gamesService)}</a>
  {d.tags.map(tag=><a href={url("/games/all/")+"?gameTag="+encodeURIComponent(tag)}>{tag}</a>)}</div>
  <p><GameGrade grade={d.grade}/> {d.status} {d.hours!==undefined&&<span> · {d.hours} {i18n(K.gamesHours)}</span>}</p>
</div></article>
<style>
.library-card{display:flex;gap:var(--m3e-space-4);padding:var(--m3e-space-4);background:var(--card-bg);color:var(--on-surface);border:1px solid var(--outline-variant);border-radius:var(--shape-corner-l);min-width:0;text-decoration:none;position:relative;font:var(--m3e-type-body-medium)}
.library-card .cover{width:clamp(84px,24%,180px);flex:none;align-self:start}
.copy{min-width:0;flex:1}.copy h2{font:var(--m3e-type-title-large);overflow-wrap:anywhere}
.copy p,.tags{margin-top:var(--m3e-space-2)}
.tags{display:flex;flex-wrap:wrap;gap:var(--m3e-space-2)}
.tags a{border-radius:var(--shape-corner-full);background:var(--surface-container-high);padding:var(--m3e-space-1) var(--m3e-space-3);font:var(--m3e-type-label-medium)}
.review-meta{color:var(--on-surface-variant)}
.library-card:hover,.library-card:focus-within{border-color:var(--primary)}
a:hover{text-decoration:underline;color:var(--primary)}a:focus-visible{outline:2px solid var(--primary);outline-offset:2px}
</style>
