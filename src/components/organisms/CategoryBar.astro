---
/** Article-local navigation. This persistent shell synchronizes after Swup replacement. */
import Chip from "@components/atoms/action/Chip.astro";
import Card from "@components/atoms/display/Card.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { siteConfig } from "@/config/siteConfig";
import { isArticlePage } from "@utils/article-navigation";
import { url } from "@utils/url-utils";
interface Props { currentPage?: string; }
const { currentPage } = Astro.props;
const separateHome = siteConfig.homePage === "about";
const entries = [
 { key: separateHome ? "blog" : "home", label: I18nKey.allPosts, href: separateHome ? "/blog/" : "/" },
 { key: "archive", label: I18nKey.archive, href: "/archive/" },
 { key: "categories", label: I18nKey.categories, href: "/categories/" },
 { key: "tags", label: I18nKey.tags, href: "/tags/" },
];
---
<nav id="category-bar-region" aria-label={i18n(I18nKey.allPosts)} hidden={!isArticlePage(currentPage, separateHome)}>
 <Card color="var(--card-bg)" radius="l" class="category-bar mb-4 p-2" id="category-bar">
  <div class="flex gap-2 overflow-x-auto hide-scrollbar">
   {entries.map(entry => <Chip variant="tonal" href={url(entry.href)} selected={currentPage === entry.key} class="shrink-0">{i18n(entry.label)}</Chip>)}
  </div>
 </Card>
</nav>
<script>
 import { siteConfig } from "@/config/siteConfig";
 import { isArticlePage } from "@utils/article-navigation";
 import { resolvePageKey } from "@utils/nav-utils";
 function syncCategoryBar() {
  const region = document.getElementById("category-bar-region");
  if (!region) return;
  const page = document.getElementById("swup-container")?.dataset.currentPage;
  region.hidden = !isArticlePage(page, siteConfig.homePage === "about");
  const routeKey = resolvePageKey(new URL(window.location.href));
  const active = routeKey === "categories" || routeKey === "tags" ? routeKey : page;
  region.querySelectorAll<HTMLAnchorElement>("a.m3-chip").forEach(link => {
   const selected = resolvePageKey(new URL(link.href)) === active;
   link.classList.toggle("m3-chip--selected", selected);
   if (selected) link.setAttribute("aria-current", "page");
   else link.removeAttribute("aria-current");
  });
 }
 syncCategoryBar();
 if (window.swup?.hooks) window.swup.hooks.on("content:replace", syncCategoryBar);
 else document.addEventListener("swup:enable", () => window.swup?.hooks.on("content:replace", syncCategoryBar));
</script>
