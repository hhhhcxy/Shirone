---
import GameCover from "@components/molecules/GameCover.astro";
import type {LibraryGame} from "@utils/game-library";
import {url} from "@utils/url-utils";
interface Props {game:LibraryGame}
const {game}=Astro.props;
---
<a class="game-tile" href={url('/games/'+game.id+'/')}>
<GameCover src={game.coverUrl}/>
<span>{game.data.title}</span></a>
<style>
.game-tile{display:flex;flex-direction:column;gap:var(--m3e-space-2);width:100%;min-width:0;text-decoration:none;color:var(--on-surface);font:var(--m3e-type-label-large)}
.game-tile>span:last-child{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;overflow-wrap:anywhere}
.game-tile:focus-visible{outline:3px solid var(--primary);outline-offset:4px;border-radius:var(--shape-corner-s)}
</style>