---
import Categories from "@components/molecules/Categories.astro";
import Tags from "@components/molecules/Tags.astro";
import { getGames, gameTaxonomy } from "@utils/game-library";
import { gamesConfig } from "@/config/gamesConfig";
import { url } from "@utils/url-utils";
const groups = gameTaxonomy(await getGames());
---
{gamesConfig.enable && <>
  <Categories items={groups.categories} id="game-categories" indexHref={url("/games/categories/")} />
  <Tags items={groups.tags} id="game-tags" indexHref={url("/games/tags/")} />
</>}
<script>import "@utils/game-filter";</script>
